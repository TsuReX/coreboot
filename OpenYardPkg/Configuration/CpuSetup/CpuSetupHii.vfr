    oneof varid = OYSetup.ConfigIOU4[1],
               prompt  = STRING_TOKEN(STR_PCIE_IOU10_PROMPT),
               help    = STRING_TOKEN(STR_PCIE_IOUX_HELP_PROMPT),
               flags       = RESET_REQUIRED,
               default value = IIO_BIFURCATE_AUTO,
               option text = STRING_TOKEN(STR_AUTO),     value = IIO_BIFURCATE_AUTO, flags = 0;
               option text = STRING_TOKEN(STR_X4X4X4X4), value = IIO_BIFURCATE_x4x4x4x4, flags = 0;
               option text = STRING_TOKEN(STR_X4X4X8),   value = IIO_BIFURCATE_x4x4xxx8, flags = 0;
               option text = STRING_TOKEN(STR_X8X4X4),   value = IIO_BIFURCATE_xxx8x4x4, flags = 0;
               option text = STRING_TOKEN(STR_X8X8),     value = IIO_BIFURCATE_xxx8xxx8, flags = 0;
               option text = STRING_TOKEN(STR_X16),      value = IIO_BIFURCATE_xxxxxx16, flags = 0;
