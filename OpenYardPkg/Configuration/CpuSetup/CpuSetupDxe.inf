[Defines]
  INF_VERSION               = 0x00010005
  BASE_NAME                 = CpuSetupDxe
  MODULE_UNI_FILE           = CpuSetupDxe.uni
  FILE_GUID                 = 28A03FF4-12B3-4305-A417-BB1A4F94093b
  MODULE_TYPE               = DXE_DRIVER
  VERSION_STRING            = 1.0
  ENTRY_POINT               = CpuSetupDxeEntryPoint

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES      = IA32 X64 ARM AARCH64
#

[Sources]
  CpuSetupDriver.c
  CpuSetupImpl.c
  CpuSetupImpl.h
  CpuSetupHii.vfr
  CpuSetupHii.h
  CpuSetupHiiStrings.uni

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  OpenYardPkg/OpenYardPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  UefiLib
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  UefiHiiServicesLib
  MemoryAllocationLib
  HiiLib
  DevicePathLib
  PrintLib
  PcdLib
  IoLib

[Guids]
  gEfiOYSetupVariableGuid

[Protocols]
  gEfiHiiConfigAccessProtocolGuid                ## PRODUCES
  gEfiDevicePathProtocolGuid                     ## PRODUCES
  gEfiDiskInfoProtocolGuid                       ## CONSUMES
  gEfiPciRootBridgeIoProtocolGuid                ## CONSUMES
  
[Pcd]
  gEfiMdePkgTokenSpaceGuid.PcdPciExpressBaseAddress

[Depex]
  gEfiGraphicsOutputProtocolGuid AND
#  gEfiHiiPackageListProtocolGuid AND
  gEfiHiiDatabaseProtocolGuid AND
#  gEfiHiiConfigAccessProtocolGuid AND
#  gEfiHiiStringProtocolGuid AND
#  gEfiFormBrowser2ProtocolGuid AND
  gEfiHiiConfigRoutingProtocolGuid
