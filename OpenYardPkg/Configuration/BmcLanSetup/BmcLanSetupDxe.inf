[Defines]
  INF_VERSION               = 0x00010005
  BASE_NAME                 = BmcLanSetupDxe
  MODULE_UNI_FILE           = BmcLanSetupDxe.uni
  FILE_GUID                 = 28A03FF4-12B3-4305-A417-BB1A4F94094b
  MODULE_TYPE               = DXE_DRIVER
  VERSION_STRING            = 1.0
  ENTRY_POINT               = BmcLanSetupDxeEntryPoint

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES      = IA32 X64 ARM AARCH64
#

[Sources]
  BmcLanSetupDriver.c
  BmcLanSetupImpl.c
  BmcLanSetupImpl.h
  BmcLanSetupHii.vfr
  BmcLanSetupHii.h
  BmcLanSetupHiiStrings.uni
  BmcLanParam.c
  BmcLanConfigCommon.h
  BmcLanConfigCommon.c

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  OYSetupPkg/OYSetupPkg.dec
  NetworkPkg/NetworkPkg.dec
  AmiIpmi2Pkg/AmiIpmi2Pkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  UefiLib
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  UefiHiiServicesLib
  MemoryAllocationLib
  HiiLib
  DevicePathLib
  PrintLib
  PcdLib
  IoLib
  NetLib
  AmiIpmiLib

[Guids]
  gEfiServerMgmtSetupVariableGuid

[Protocols]
  gEfiHiiConfigAccessProtocolGuid                ## PRODUCES
  gEfiDevicePathProtocolGuid                     ## PRODUCES
  gEfiDiskInfoProtocolGuid                       ## CONSUMES
  gEfiPciRootBridgeIoProtocolGuid                ## CONSUMES
  gEfiDxeIpmiTransportProtocolGuid
  
[Pcd]
  gEfiMdePkgTokenSpaceGuid.PcdPciExpressBaseAddress

[Depex]
  gEfiGraphicsOutputProtocolGuid AND
  gEfiHiiPackageListProtocolGuid AND
  gEfiHiiDatabaseProtocolGuid AND
  gEfiHiiConfigAccessProtocolGuid AND
  gEfiHiiStringProtocolGuid AND
  gEfiHiiConfigRoutingProtocolGuid AND
  gEfiFormBrowser2ProtocolGuid
