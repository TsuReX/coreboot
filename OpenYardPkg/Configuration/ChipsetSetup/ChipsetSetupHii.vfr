               flags    = RESET_REQUIRED,
           default = TRUE,	  
    endcheckbox;

    subtitle text = STRING_TOKEN(STR_EMPTY);
	
  grayoutif TRUE;
       subtitle text = STRING_TOKEN(STR_SATA_2_SETUP_PORT_5_DISK);
  endif;
  
    checkbox varid   = OYSetup.SataPortController2[5],
