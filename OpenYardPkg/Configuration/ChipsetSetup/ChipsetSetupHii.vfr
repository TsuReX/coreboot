               help     = STRING_TOKEN(STR_SATA_2_SETUP_PORT_ENABLE_HELP),
               flags    = RESET_REQUIRED,
           default = TRUE,	  
    endcheckbox;

    subtitle text = STRING_TOKEN(STR_EMPTY);
    
  grayoutif TRUE;
       subtitle text = STRING_TOKEN(STR_SATA_2_SETUP_PORT_6_DISK);
  endif;
  
    checkbox varid   = OYSetup.SataPortController2[6],
               prompt   = STRING_TOKEN(STR_SATA_2_SETUP_PORT_6),
               help     = STRING_TOKEN(STR_SATA_2_SETUP_PORT_ENABLE_HELP),
               flags    = RESET_REQUIRED,
           default = TRUE,  
    endcheckbox;

    subtitle text = STRING_TOKEN(STR_EMPTY);
  
  grayoutif TRUE;
       subtitle text = STRING_TOKEN(STR_SATA_2_SETUP_PORT_7_DISK);
  endif;
  
    checkbox varid   = OYSetup.SataPortController2[7],
               prompt   = STRING_TOKEN(STR_SATA_2_SETUP_PORT_7),
