[Defines]
  INF_VERSION               = 0x00010005
  BASE_NAME                 = VarstoreInfoDxe
  MODULE_UNI_FILE           = VarstoreInfoDxe.uni
  FILE_GUID                 = 28A03FF4-12B3-4305-A417-BB1A4F940820
  MODULE_TYPE               = DXE_DRIVER
  VERSION_STRING            = 1.0
  ENTRY_POINT               = VarstoreInfoDxeEntryPoint

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES      = IA32 X64 ARM AARCH64
#

[Sources]
  VarstoreInfoDriver.c
  VarstoreInfoImpl.c
  VarstoreInfoImpl.h
  VarstoreInfoHii.vfr
  VarstoreInfoHiiStrings.uni

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  UefiLib
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  UefiRuntimeServicesTableLib
  UefiHiiServicesLib
  MemoryAllocationLib
  HiiLib
  DevicePathLib
  PrintLib
  PcdLib

[Guids]

[Protocols]
  gEfiHiiConfigAccessProtocolGuid                ## PRODUCES
  gEfiDevicePathProtocolGuid                     ## PRODUCES

[Pcd]

[Depex]
  #gEfiGraphicsOutputProtocolGuid AND
  #gEfiHiiPackageListProtocolGuid AND
  gEfiHiiDatabaseProtocolGuid AND
  #gEfiHiiConfigAccessProtocolGuid AND
  #gEfiHiiStringProtocolGuid AND
  #gEfiFormBrowser2ProtocolGuid AND
  gEfiHiiConfigRoutingProtocolGuid
